<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Acción global: volver al login limpiando la pila (sesión cerrada/expirada) -->
    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.eva_2.LoginFragment"
        android:label="@string/label_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_panelFragment"
            app:destination="@id/panelFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/panelFragment"
        android:name="com.example.eva_2.PanelFragment"
        android:label="@string/label_panel"
        tools:layout="@layout/fragment_panel">
        <action
            android:id="@+id/action_panelFragment_to_historialFragment"
            app:destination="@id/historialFragment" />
    </fragment>

    <fragment
        android:id="@+id/historialFragment"
        android:name="com.example.eva_2.HistorialFragment"
        android:label="@string/label_historial"
        tools:layout="@layout/fragment_historial" />
</navigation>
